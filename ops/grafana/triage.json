{
  "uid": "triage",
  "title": "Support ticket triage",
  "schemaVersion": 40,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(triage_requests_total{instance=\"$instance\"}[30s]))",
          "legendFormat": "requests/s"
        }
      ]
    },
    {
      "id": 2,
      "title": "Request latency (s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5,sum by(le)(rate(triage_latency_seconds_bucket{instance=\"$instance\"}[30s])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(triage_latency_seconds_bucket{instance=\"$instance\"}[30s])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99,sum by(le)(rate(triage_latency_seconds_bucket{instance=\"$instance\"}[30s])))",
          "legendFormat": "p99"
        },
        {
          "refId": "D",
          "expr": "0.15 * max(up{job=\"triage\",instance=\"api:8000\",instance=\"$instance\"} == 1)",
          "legendFormat": "fixture SLO"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request errors (%) and upstream failures per 100 requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by(outcome)(rate(triage_requests_total{outcome!=\"ok\",instance=\"$instance\"}[30s])) / scalar(sum(rate(triage_requests_total{instance=\"$instance\"}[30s])))",
          "legendFormat": "{{outcome}}"
        },
        {
          "refId": "B",
          "expr": "100 * sum by(kind)(rate(triage_call_errors_total{instance=\"$instance\"}[30s])) / scalar(sum(rate(triage_requests_total{instance=\"$instance\"}[30s])))",
          "legendFormat": "upstream {{kind}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Secondary responses (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(triage_fallback_total{instance=\"$instance\"}[30s])) / sum(rate(triage_requests_total{instance=\"$instance\"}[30s]))",
          "legendFormat": "fallback"
        }
      ]
    },
    {
      "id": 5,
      "title": "Priced usage (USD/min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum(rate(triage_cost_usd_total{instance=\"$instance\"}[30s]))",
          "legendFormat": "standard rate"
        }
      ]
    },
    {
      "id": 6,
      "title": "Observed availability & remaining 7-day budget (%)",
      "description": "Uses eligible request counters from the selected API. Check the seven-day scrape coverage report before claiming the SLO was met.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(increase(triage_requests_total{outcome=\"ok\",cohort!=\"unassigned\",instance=\"$instance\"}[7d])) / sum(increase(triage_requests_total{cohort!=\"unassigned\",instance=\"$instance\"}[7d]))",
          "legendFormat": "availability"
        },
        {
          "refId": "B",
          "expr": "100 * (1 - (1 - sum(increase(triage_requests_total{outcome=\"ok\",cohort!=\"unassigned\",instance=\"$instance\"}[7d]))/sum(increase(triage_requests_total{cohort!=\"unassigned\",instance=\"$instance\"}[7d])))/0.01)",
          "legendFormat": "remaining"
        }
      ]
    },
    {
      "id": 7,
      "title": "First-output schema validity (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by(cohort)(rate(triage_first_schema_total{valid=\"true\",instance=\"$instance\"}[30s])) / sum by(cohort)(rate(triage_first_schema_total{instance=\"$instance\"}[30s]))",
          "legendFormat": "{{cohort}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Token throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(direction)(rate(triage_tokens_total{instance=\"$instance\"}[30s]))",
          "legendFormat": "{{direction}}"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "API instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom"
        },
        "query": "label_values(triage_requests_total, instance)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {}
      }
    ]
  }
}
